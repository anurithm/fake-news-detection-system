# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python Cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
*.pyo

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Databases (prediction history — generated at runtime) ─────────────────────
data/predictions.db
*.db

# ── Large Kaggle Dataset Files (NOT committed — set up via README) ─────────────
# Place Fake.csv and True.csv in a local directory and pass via --dataset flag
Fake.csv
True.csv
data/Fake.csv
data/True.csv

# ── Trained Model Files ───────────────────────────────────────────────────────
# Models are generated by running: python src/train.py
# - random_forest.joblib is ~34 MB and cannot be committed to GitHub
# - All other models (~300 KB–2 MB each) can optionally be tracked with Git LFS
# Uncommit this block if you want to commit smaller models:
models/

# ── Generated Reports (charts are regenerated on each training run) ───────────
reports/*.png
reports/*.jpg

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Testing Cache ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Distribution / Build ──────────────────────────────────────────────────────
dist/
build/
*.egg-info/
